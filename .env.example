# ─────────────────────────────────────────────────────────────
# 007 Tikinti Bazarı — environment settings
# Copy to .env.local (local) or add in Vercel → Settings → Environment Variables.
# Leave a value empty if it is not yet known — the site handles that safely.
# ─────────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=

# Business phone, international format, digits only, e.g. 994XXXXXXXXX (no +, no spaces).
# Must be confirmed by the business owner before launch.
NEXT_PUBLIC_PHONE=
# WhatsApp number in the same format. If empty, NEXT_PUBLIC_PHONE is used.
NEXT_PUBLIC_WHATSAPP=

# Instagram profile URL (optional)
NEXT_PUBLIC_INSTAGRAM_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (optional; loads only after visitor consent)
NEXT_PUBLIC_GA_ID=
# Google Search Console HTML-tag verification code (optional, the content="..." value only)
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact form destination (server-only — never prefix with NEXT_PUBLIC_).
# If both are empty, the form sends via WhatsApp instead of the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
